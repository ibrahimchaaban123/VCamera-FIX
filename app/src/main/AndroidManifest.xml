<service android:name="virtual.camera.app.camera.CameraService" android:exported="false" android:foregroundServiceType="camera|microphone"/>
<receiver android:name="virtual.camera.app.app.BootReceiver" android:exported="true">
<intent-filter>
<action android:name="android.intent.action.BOOT_COMPLETED"/>
<action android:name="android.intent.action.QUICKBOOT_POWERON"/>
</intent-filter>
</receiver>
</application>
</manifest>
